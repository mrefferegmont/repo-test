@page
@model IndexModel
@{
    ViewData["Title"] = "Weather Forecast";
}

<div class="text-center">
    <h1 class="display-4">Weekly Weather Forecast</h1>
    <p class="lead">7-day weather forecast starting from tomorrow</p>
</div>

<div class="container mt-5">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th scope="col">Date</th>
                <th scope="col">Temperature (°C)</th>
                <th scope="col">Temperature (°F)</th>
                <th scope="col">Summary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var forecast in Model.WeatherForecasts)
            {
                <tr>
                    <td>@forecast.Date.ToString("dddd, MMMM dd, yyyy")</td>
                    <td>@forecast.TemperatureC °C</td>
                    <td>@forecast.TemperatureF °F</td>
                    <td>
                        <span class="badge bg-primary">@forecast.Summary</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
